# Python Agent Service runtime configuration
GO_CAPABILITY_BASE_URL=http://127.0.0.1:8909

# Model provider placeholders; no model client is created in Task 1.2.
MODEL_PROVIDER=openai_compatible
MODEL_API_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=

# Leave unset to use the default, which is outside the source tree so a
# one-shot module run cannot write into the copied legacy assets.  The launcher
# sets its own path.
# DB_PATH=

# Remote tracing stays off unless a key is present; without it turns are
# recorded only in the local business trace.
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=koubo-agent-upgrade

LOG_LEVEL=INFO
AGENT_HOST=127.0.0.1
AGENT_PORT=8090
